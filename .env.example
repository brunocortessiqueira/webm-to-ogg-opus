# =============================================================================
# Variáveis de ambiente da API de conversão de mídia
#
# Copie para `.env` e ajuste. O único obrigatório é API_KEY — sem ele a
# aplicação não sobe.
# =============================================================================

# Chave usada no header `Authorization: Bearer <API_KEY>`.
# OBRIGATÓRIA. Gere algo longo e aleatório, por exemplo:
#   openssl rand -hex 32
API_KEY=

PORT=3000
NODE_ENV=production
LOG_LEVEL=info


# ── Conversão de áudio (POST /convert) ───────────────────────────────────────
#
# O áudio trafega em base64 dentro do JSON, então os dois limites andam juntos:
# JSON_BODY_LIMIT precisa ser maior que MAX_AUDIO_BYTES, porque base64 infla o
# conteúdo em ~33%.

# Teto do áudio decodificado. Padrão: 25 MB.
MAX_AUDIO_BYTES=26214400

# Teto do corpo JSON, já contando a inflação do base64. Padrão: 35mb.
JSON_BODY_LIMIT=35mb

# Teto do processo ffmpeg para áudio. Padrão: 30 s.
FFMPEG_TIMEOUT_MS=30000


# ── Conversão de vídeo (POST /convert/video) ─────────────────────────────────
#
# Vídeo joga em outra escala: 2 minutos gravados por um celular dão ~174 MB. Por
# isso o endpoint recebe uma URL em vez do conteúdo, e tem limites próprios.

# Teto do arquivo BAIXADO da origem. Padrão: 300 MB.
MAX_VIDEO_BYTES=314572800

# Teto do processo ffmpeg para vídeo. A recodificação roda a ~14x tempo real,
# então 4 minutos de vídeo levam ~17 s; 180 s cobre o pior caso com folga.
FFMPEG_VIDEO_TIMEOUT_MS=180000

# Teto para o download da origem. Padrão: 120 s.
MEDIA_FETCH_TIMEOUT_MS=120000

# Tamanho ALVO da saída. É o limite de mídia do destino — 16 MB para o
# WhatsApp Cloud API. O bitrate é calculado a partir dele e da duração.
MEDIA_TARGET_BYTES=16777216

# OBRIGATÓRIA PARA VÍDEO. Lista de hosts, separados por vírgula, de onde
# `source_url` pode ser baixada.
#
# Buscar uma URL escolhida pelo cliente é uma porta de SSRF: sem esta lista,
# bastaria apontar para 169.254.169.254 ou para um serviço interno da VPS. Deixar
# vazia faz o endpoint de vídeo recusar tudo — falha fechada, de propósito.
#
# Exemplo:
#   MEDIA_ALLOWED_HOSTS=chatapi.partlab.com.br,storage.partlab.com.br
MEDIA_ALLOWED_HOSTS=


# ── Rate limit ───────────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
