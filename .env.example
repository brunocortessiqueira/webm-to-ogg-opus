# =============================================================================
# CONFIGURAÇÃO DA API DE CONVERSÃO DE ÁUDIO
# Copie este arquivo para .env e preencha os valores antes de executar.
# NUNCA commite o arquivo .env com valores reais.
# =============================================================================

# Porta em que o servidor vai escutar
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Chave de API obrigatória para autenticação Bearer.
# Use uma string longa e aleatória gerada com: openssl rand -hex 32
API_KEY=e7e040990bf3dc44e6b0797d4c4fe39a3beaa05a6357d499ec702a6642235907

# Tamanho máximo do buffer de áudio (em bytes) após decodificação base64.
# Padrão: 26214400 = 25 MB
MAX_AUDIO_BYTES=26214400

# Limite do corpo da requisição JSON aceito pelo Express.
# Deve ser maior que MAX_AUDIO_BYTES convertido para base64 (~33% a mais).
# Padrão: 35mb
JSON_BODY_LIMIT=35mb

# Timeout em milissegundos para o processo ffmpeg.
# Padrão: 30000 = 30 segundos
FFMPEG_TIMEOUT_MS=30000

# Janela de tempo do rate limiting (em milissegundos).
# Padrão: 60000 = 1 minuto
RATE_LIMIT_WINDOW_MS=60000

# Número máximo de requisições por IP dentro da janela.
# Padrão: 60
RATE_LIMIT_MAX_REQUESTS=60

# Nível de log: error | warn | info | debug
LOG_LEVEL=info
